# Hostinger / Apache — single-page app routing.
# Serve real files (assets, images) as-is; every other path (/en, /ar/help, …)
# falls back to index.html so React Router can render it (no 404 on refresh).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Never cache index.html, so a new deploy shows up immediately.
# CSS filenames are stable (Clarity replay). Revalidate them so a new
# build is not stuck behind a cached copy of the same URL.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.css$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
